---
import Layout from "../layouts/Layout.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import PaymentMethods from "../components/PaymentMethods.astro";
import ProductCard from "../components/ProductCard.astro";
import { authorizedDealers, categories, featuredProducts, galleryImages, shopDetails } from "../data/products";

const generalMessage = encodeURIComponent("আসসালামু আলাইকুম, বিসমিল্লাহ হার্ডওয়্যার ও পেইন্ট সম্পর্কে জানতে চাই।");
const whatsappHref = `https://wa.me/${shopDetails.whatsappNumber}?text=${generalMessage}`;
---

<Layout>
	<header class="site-header"><div class="container header-inner"><a class="brand" href="#top" aria-label="বিসমিল্লাহ হার্ডওয়্যার ও পেইন্ট হোম"><span class="brand-mark">BHS</span><span class="brand-copy"><strong>বিসমিল্লাহ</strong><span>হার্ডওয়্যার ও পেইন্ট</span></span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="মেনু খুলুন">Menu</button><nav id="site-nav" class="site-nav" aria-label="প্রধান নেভিগেশন"><a href="/products">পণ্যসমূহ</a><a href="#partners">পার্টনার</a><a href="#about">আমাদের কথা</a><a href={whatsappHref} target="_blank" rel="noreferrer" aria-label="WhatsApp-এ যোগাযোগ করুন" title="WhatsApp-এ যোগাযোগ করুন"><WhatsAppIcon size={19} /></a></nav></div></header>

	<main id="top">
		<section class="hero-section"><div class="container hero-grid"><div class="hero-copy"><p class="kicker">BHS · Local dealer point</p><strong class="hero-brand-name">বিসমিল্লাহ হার্ডওয়্যার ও পেইন্ট</strong><h1>আপনার কাজের জন্য <em>ভরসার</em> জিনিস।</h1><p class="hero-lead">রং, হার্ডওয়্যার ও দৈনন্দিন নির্মাণ সামগ্রী বাছাইয়ে বিসমিল্লাহ হার্ডওয়্যার ও পেইন্ট পাশে আছে। পণ্যের দাম নয়, সঠিক পণ্য ও সহজ যোগাযোগই আমাদের প্রথম কথা।</p><div class="hero-actions"><a class="button button-dark" href="/products">পণ্য দেখুন <span>↗</span></a><a class="text-link" href={whatsappHref} target="_blank" rel="noreferrer" aria-label="WhatsApp-এ কথা বলুন" title="WhatsApp-এ কথা বলুন"><WhatsAppIcon size={19} /></a></div><div class="hero-note"><span class="pulse-dot"></span> Dealer point for selected companies</div></div><div class="hero-stamp" aria-label="বিসমিল্লাহ হার্ডওয়্যার ও পেইন্ট ব্র্যান্ড মার্ক"><div class="stamp-ring"></div><span class="stamp-small">বিসমিল্লাহ</span><strong>BHS</strong><span class="stamp-small">হার্ডওয়্যার ও পেইন্ট</span><div class="stamp-line"></div><span class="stamp-owner">Pro: Md Nahid Mondol</span></div></div><div class="hero-ticker" aria-hidden="true"><span>PAINT</span><span>HARDWARE</span><span>TOOLS</span><span>TRUST</span><span>PAINT</span><span>HARDWARE</span></div></section>
		<section class="category-section" aria-labelledby="category-title"><div class="container"><div class="section-heading compact-heading"><div><p class="kicker">Start with a category</p><h2 id="category-title">যে কাজ, সেই সমাধান।</h2></div><p>প্রয়োজনীয় category বেছে নিয়ে পণ্যের availability ও quotation জানতে সরাসরি <WhatsAppIcon /> বার্তা পাঠান।</p></div><div class="category-grid">{categories.map((category) => <a class="category-card" href={`/products?category=${category.id}`}><span class="category-number">{category.icon}</span><span><strong>{category.labelBn}</strong><small>{category.label}</small></span><span class="category-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
		<section class="featured-section" aria-labelledby="featured-title"><div class="container"><div class="section-heading"><div><p class="kicker">Popular picks</p><h2 id="featured-title">Top products</h2></div><a class="text-link" href="/products">সব পণ্য দেখুন <span>↗</span></a></div><div class="product-grid featured-grid">{featuredProducts.map((product) => <ProductCard product={product} />)}</div></div></section>
		<section class="gallery-section" aria-labelledby="gallery-title"><div class="container"><div class="section-heading"><div><p class="kicker">Inside BHS</p><h2 id="gallery-title">দোকানের কিছু ঝলক</h2></div><p class="gallery-intro">আপনার প্রয়োজনের পণ্যগুলো আমাদের দোকানে সাজানো আছে। নতুন ছবি যোগ হলে এই gallery-তে সহজেই যুক্ত করা যাবে।</p></div><div class="shop-gallery">{galleryImages.map((image, index) => <figure class={`gallery-image gallery-image-${index + 1}`}><img src={image.src} alt={image.alt} loading={index === 0 ? "eager" : "lazy"} /></figure>)}</div></div></section>
		<section class="partner-section" id="partners" aria-labelledby="partner-title"><div class="container partner-layout"><div><p class="kicker">Authorized dealer</p><h2 id="partner-title">বিশ্বস্ত<br /><em>ব্র্যান্ডের পাশে।</em></h2><p class="partner-copy">BHS অনুমোদিত ডিলার হিসেবে নির্বাচিত ব্র্যান্ডের পণ্য সরবরাহ করে। প্রতিটি ব্র্যান্ডের logo এখানে যুক্ত করা যাবে।</p><a class="text-link dark-link" href={whatsappHref} target="_blank" rel="noreferrer">ডিলার তথ্য জানতে চান? <span>↗</span></a></div><div class="partner-marquee" aria-label="BHS authorized dealers"><div class="partner-track">{[...authorizedDealers, ...authorizedDealers].map((dealer, index) => <div class="partner-row"><span class="partner-logo">{dealer.logo ? <img src={dealer.logo} alt={`${dealer.name} logo`} /> : dealer.name.slice(0, 2)}</span><div><strong>{dealer.name}</strong><small>{dealer.note}</small></div><span class="partner-status">Authorized</span></div>)}</div></div></div></section>
		<section class="about-section" id="about" aria-labelledby="about-title"><div class="container about-layout"><div class="owner-card"><span class="owner-label">The person behind BHS</span><div class="owner-initials">MN</div><p class="owner-role">Proprietor</p><h2>Md Nahid<br />Mondol</h2><span class="owner-line"></span><p>Owner information, story, and photograph will be added here as they are provided.</p></div><div class="about-copy"><p class="kicker">A shop with a point of view</p><h2 id="about-title">কাজটা ভালো হলে,<br /><em>জিনিসটাও ভালো চাই।</em></h2><p>হাতে-কলমে কাজ করা মানুষদের জন্য দোকান মানে শুধু shelf নয়। কোন product কোথায় কাজে লাগে, কোন finish টেকসই, কোন fitting দরকার — এই ছোট সিদ্ধান্তগুলোর পাশে থাকাই BHS-এর উদ্দেশ্য।</p><div class="contact-strip"><span><small>Direct inquiry</small><strong>{shopDetails.whatsappDisplay}</strong></span><a class="button button-red" href={whatsappHref} target="_blank" rel="noreferrer" aria-label="WhatsApp-এ কথা বলুন" title="WhatsApp-এ কথা বলুন"><WhatsAppIcon size={19} /></a></div><div class="contact-details"><p><small>Shop address</small><strong>{shopDetails.address}</strong></p><div><small>Payment available</small><PaymentMethods /></div></div></div></div></section>
	</main>
	<footer class="site-footer"><div class="container footer-inner"><div><span class="footer-brand">BHS</span><p>বিসমিল্লাহ হার্ডওয়্যার ও পেইন্ট</p></div><div><p>{shopDetails.whatsappDisplay}</p><p class="footer-muted">{shopDetails.address}</p></div><a href="#top" class="back-top" aria-label="উপরে ফিরে যান">↑</a></div></footer>
</Layout>

<script>
	const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
	const navigation = document.querySelector<HTMLElement>(".site-nav");
	menuToggle?.addEventListener("click", () => { const isOpen = navigation?.classList.toggle("open") ?? false; menuToggle.setAttribute("aria-expanded", String(isOpen)); });
	navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { navigation.classList.remove("open"); menuToggle?.setAttribute("aria-expanded", "false"); }));
</script>
