---
import { shopDetails, type Product } from "../data/products";
import WhatsAppIcon from "./WhatsAppIcon.astro";

type Props = {
  product: Product;
};

const { product } = Astro.props;
const inquiryText = encodeURIComponent(`আসসালামু আলাইকুম, ${product.name} পণ্যটি সম্পর্কে জানতে চাই।`);
const whatsappHref = `https://wa.me/${shopDetails.whatsappNumber}?text=${inquiryText}`;
---

<article class="product-card" data-category={product.category}>
  <div class="product-art" aria-hidden="true">
    {product.image ? <img src={product.image} alt="" loading="lazy" /> : <span>{product.id.slice(-3)}</span>}
    <span class="product-tag">Inquiry only</span>
  </div>
  <div class="product-copy">
    <p class="eyebrow">{product.category}</p>
    <h3>{product.nameBn}</h3>
    <p class="product-name">{product.name}</p>
    <p class="product-description">{product.description}</p>
    {product.authorizedDealer && <p class="partner-line">Authorized Dealer · {product.authorizedDealer}</p>}
    <a class="product-action" href={whatsappHref} target="_blank" rel="noreferrer" aria-label={`${product.name} এর দাম জানতে বার্তা পাঠান`} title="দাম জানতে বার্তা পাঠান">
      <span class="whatsapp-label"><WhatsAppIcon size={19} /> <span>দাম জানতে</span></span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
